<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup><Compile Remove="OverlaySmoke/**/*.cs" /></ItemGroup>
  <ItemGroup><PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" /></ItemGroup>
  <ItemGroup>
    <Compile Include="../Models/*.cs" Link="Models/%(Filename)%(Extension)"/>
    <Compile Include="../ViewModels/*.cs" Link="ViewModels/%(Filename)%(Extension)"/>
    <Compile Include="../Services/*.cs" Exclude="../Services/ControllerConnection.cs;../Services/WpfUiScheduler.cs;../Services/WpfCalibrationOverlay.cs" Link="Services/%(Filename)%(Extension)"/>
  </ItemGroup>
</Project>
