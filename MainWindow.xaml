<Window x:Class="OculusGoAirMouse.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding Title}" Width="940" Height="760" MinWidth="760" MinHeight="560" Closing="OnClosing">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Oculus Go Air Mouse" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="连接控制器，让熟悉的动作掌控桌面。" Margin="0,8,0,20" Opacity="0.7"/></StackPanel>
    <Border Grid.Row="1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,20">
      <StackPanel><TextBlock x:Name="ConnectionStatus" Text="{Binding ConnectionStatus}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="EngineStatus" Text="{Binding EngineStatus}" Margin="0,8,0,16"/><WrapPanel>
        <Button Padding="16,9" Margin="0,0,10,0" x:Name="ConnectButton" Content="搜索并连接" Command="{Binding ConnectCommand}"/>
        <Button Padding="16,9" Margin="0,0,10,0" x:Name="DisconnectButton" Content="断开 / 取消" Command="{Binding DisconnectCommand}"/>
        <Button Padding="16,9" Margin="0,0,10,0" x:Name="MouseButton" Content="{Binding MouseButtonText}" Command="{Binding ToggleMouseCommand}"/>
        <Button Padding="16,9" Margin="0,0,10,0" x:Name="CalibrateButton" Content="重新校准" Command="{Binding CalibrateCommand}"/>
      </WrapPanel>
        <TextBlock Text="首次使用请先配对：Windows 设置 → 蓝牙和设备 → 添加设备 → 蓝牙。完成控制器配对后再连接；本程序不会自动执行系统配对。" TextWrapping="Wrap" Margin="0,14,0,0" Opacity="0.8"/>
      </StackPanel>
    </Border>
    <TabControl Grid.Row="2">
      <TabItem Header="使用说明"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
        <TextBlock Text="从连接开始" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="1. 首次使用或换电脑：先让控制器进入配对模式。打开 Windows“设置 → 蓝牙和设备 → 添加设备 → 蓝牙”，选择控制器并确认配对完成。只发现设备不代表已配对。&#10;2. 关闭其他电脑上的控制器程序，避免同时连接。&#10;3. 按 Trigger 唤醒控制器。默认启动后自动搜索、连接并开启鼠标，也可点击“搜索并连接”。&#10;4. 默认允许未校准使用；如需校准，点击“重新校准”或长按 Oculus 1 秒，并保持控制器静止。" TextWrapping="Wrap" LineHeight="30" Margin="0,14,0,24"/>
        <TextBlock Text="控制方式" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Oculus 按下：立即将光标移到主显示器中央&#10;Oculus 持续按住 1 秒：自动重新校准（无需松开），请保持控制器静止&#10;Trigger：左键，按住可拖拽&#10;Back：右键&#10;触摸板：上下 / 左右滚动（传统整格滚动）&#10;关闭窗口或断开连接：停止控制并释放鼠标按键" LineHeight="30" Margin="0,12,0,20"/>
        <TextBlock Text="参数可在设置页修改并保存；保存后暂停鼠标，是否自动校准由设置控制。蓝牙名称与超时设置在下一次连接时使用。" TextWrapping="Wrap" Opacity="0.7"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="设置"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Settings.Fields}" IsEnabled="{Binding Settings.IsAvailable}" Margin="0,0,16,8">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                <TextBox x:Name="TextEditor" Grid.Column="1" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox x:Name="BooleanEditor" Grid.Column="1" IsChecked="{Binding BooleanValue}" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                  <Setter TargetName="TextEditor" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="BooleanEditor" Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl></ScrollViewer>
        <TextBlock x:Name="SettingsMessage" Text="{Binding Settings.Message}" Grid.Row="1" TextWrapping="Wrap" Margin="0,12"/>
        <StackPanel Grid.Row="2"><WrapPanel><Button Padding="16,9" Margin="0,0,10,0" Content="保存并应用" Command="{Binding Settings.SaveCommand}"/><Button Padding="16,9" Margin="0,0,10,0" Content="放弃未保存修改" Command="{Binding Settings.ReloadCommand}"/></WrapPanel><TextBlock x:Name="ConfigPath" Text="{Binding Settings.ConfigPath}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
      </Grid></TabItem>
      <TabItem Header="连接日志"><TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" TextChanged="OnLogTextChanged" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="16"/></TabItem>
    </TabControl>
  </Grid>
</Window>

