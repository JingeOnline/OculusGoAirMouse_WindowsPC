<Window x:Class="OculusGoAirMouse.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Oculus Go Air Mouse" Width="940" Height="760" MinWidth="760" MinHeight="560" Closing="OnClosing">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Oculus Go Air Mouse" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="连接控制器，让熟悉的动作掌控桌面。" Margin="0,8,0,20" Opacity="0.7"/></StackPanel>
    <Border Grid.Row="1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,20">
      <StackPanel><TextBlock x:Name="ConnectionStatus" Text="未连接" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="EngineStatus" Text="连接后请静置控制器进行校准。" Margin="0,8,0,16"/><WrapPanel>
        <Button Padding="16,9" Margin="0,0,10,0" x:Name="ConnectButton" Content="搜索并连接" Click="ConnectClick"/>
        <Button Padding="16,9" Margin="0,0,10,0" x:Name="DisconnectButton" Content="断开 / 取消" Click="DisconnectClick" IsEnabled="False"/>
        <Button Padding="16,9" Margin="0,0,10,0" x:Name="MouseButton" Content="开启鼠标" Click="MouseClick" IsEnabled="False"/>
        <Button Padding="16,9" Margin="0,0,10,0" x:Name="CalibrateButton" Content="重新校准" Click="CalibrateClick" IsEnabled="False"/>
      </WrapPanel></StackPanel>
    </Border>
    <TabControl Grid.Row="2">
      <TabItem Header="使用说明"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
        <TextBlock Text="从连接开始" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="1. 在 Windows 蓝牙设置中配对控制器，并退出 Python 版本。&#10;2. 按 Trigger 唤醒控制器，然后点击“搜索并连接”。&#10;3. 静置完成校准，再点击“开启鼠标”。" TextWrapping="Wrap" LineHeight="30" Margin="0,14,0,24"/>
        <TextBlock Text="控制方式" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Oculus：光标回到主显示器中央&#10;Trigger：左键，按住可拖拽&#10;Back：右键&#10;触摸板：上下 / 左右滚动（传统整格滚动）&#10;关闭窗口或断开连接：停止控制并释放鼠标按键" LineHeight="30" Margin="0,12,0,20"/>
        <TextBlock Text="参数可在设置页修改并保存；保存后暂停鼠标并重新校准。蓝牙名称与超时设置在下一次连接时使用。" TextWrapping="Wrap" Opacity="0.7"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="设置"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsPanel" Margin="0,0,16,8"/></ScrollViewer>
        <TextBlock x:Name="SettingsMessage" Grid.Row="1" TextWrapping="Wrap" Margin="0,12"/>
        <StackPanel Grid.Row="2"><WrapPanel><Button Padding="16,9" Margin="0,0,10,0" Content="保存并应用" Click="SaveClick"/><Button Padding="16,9" Margin="0,0,10,0" Content="放弃未保存修改" Click="ReloadClick"/></WrapPanel><TextBlock x:Name="ConfigPath" FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
      </Grid></TabItem>
      <TabItem Header="连接日志"><TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="16"/></TabItem>
    </TabControl>
  </Grid>
</Window>

