<Window x:Class="OculusGoAirMouse.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OculusGoAirMouse.Services" Title="{Binding Title}" Width="940" Height="760" MinWidth="760" MinHeight="640" Closing="OnClosing">
  <Window.Resources><local:WpfLanguageTextConverter x:Key="LanguageText"/></Window.Resources>
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0"><TextBlock Text="Oculus Go Air Mouse" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{Binding Texts[UI.Subtitle]}" TextWrapping="Wrap" Margin="0,8,0,20" Opacity="0.7"/></StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Top"><TextBlock Text="Language / 语言 / 言語" Margin="0,0,0,5"/><ComboBox Width="190" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="DisplayName"/></StackPanel>
    </Grid>
    <Border Grid.Row="1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,20">
      <StackPanel><TextBlock x:Name="ConnectionStatus" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"><TextBlock.Text><MultiBinding Converter="{StaticResource LanguageText}" Mode="OneWay"><Binding Path="ConnectionStatus"/><Binding Path="DataContext.Texts.Language" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/></MultiBinding></TextBlock.Text></TextBlock><TextBlock x:Name="EngineStatus" TextWrapping="Wrap" Margin="0,8,0,16"><TextBlock.Text><MultiBinding Converter="{StaticResource LanguageText}" Mode="OneWay"><Binding Path="EngineStatus"/><Binding Path="DataContext.Texts.Language" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/></MultiBinding></TextBlock.Text></TextBlock><WrapPanel>
        <Button Padding="16,9" Margin="0,0,10,0" x:Name="ConnectButton" Content="{Binding Texts[UI.Connect]}" Command="{Binding ConnectCommand}"/>
        <Button Padding="16,9" Margin="0,0,10,0" x:Name="DisconnectButton" Content="{Binding Texts[UI.Disconnect]}" Command="{Binding DisconnectCommand}"/>
        <Button Padding="16,9" Margin="0,0,10,0" x:Name="MouseButton" Command="{Binding ToggleMouseCommand}"><Button.Content><MultiBinding Converter="{StaticResource LanguageText}" Mode="OneWay"><Binding Path="MouseButtonText"/><Binding Path="DataContext.Texts.Language" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/></MultiBinding></Button.Content></Button>
        <Button Padding="16,9" Margin="0,0,10,0" x:Name="CalibrateButton" Content="{Binding Texts[UI.Calibrate]}" Command="{Binding CalibrateCommand}"/>
      </WrapPanel>
        <TextBlock Text="{Binding Texts[UI.PairingHint]}" TextWrapping="Wrap" Margin="0,14,0,0" Opacity="0.8"/>
      </StackPanel>
    </Border>
    <TabControl Grid.Row="2">
      <TabItem Header="{Binding Texts[UI.HelpTab]}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
        <TextBlock Text="{Binding Texts[UI.GettingStarted]}" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Texts[UI.UsageSteps]}" TextWrapping="Wrap" LineHeight="30" Margin="0,14,0,24"/>
        <TextBlock Text="{Binding Texts[UI.ControlsHeading]}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Texts[UI.ControlsText]}" LineHeight="30" Margin="0,12,0,20"/>
        <TextBlock Text="{Binding Texts[UI.SettingsHint]}" TextWrapping="Wrap" Opacity="0.7"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{Binding Texts[UI.SettingsTab]}"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Settings.Fields}" IsEnabled="{Binding Settings.IsAvailable}" Margin="0,0,16,8">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"><TextBlock.Text><MultiBinding Converter="{StaticResource LanguageText}" Mode="OneWay"><Binding Path="Label"/><Binding Path="DataContext.Texts.Language" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/></MultiBinding></TextBlock.Text></TextBlock>
                <TextBox x:Name="TextEditor" Grid.Column="1" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox x:Name="BooleanEditor" Grid.Column="1" IsChecked="{Binding BooleanValue}" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                  <Setter TargetName="TextEditor" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="BooleanEditor" Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl></ScrollViewer>
        <TextBlock x:Name="SettingsMessage" Grid.Row="1" TextWrapping="Wrap" Margin="0,12"><TextBlock.Text><MultiBinding Converter="{StaticResource LanguageText}" Mode="OneWay"><Binding Path="Settings.Message"/><Binding Path="DataContext.Texts.Language" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/></MultiBinding></TextBlock.Text></TextBlock>
        <StackPanel Grid.Row="2"><WrapPanel><Button Padding="16,9" Margin="0,0,10,0" Content="{Binding Texts[UI.Save]}" Command="{Binding Settings.SaveCommand}"/><Button Padding="16,9" Margin="0,0,10,0" Content="{Binding Texts[UI.Discard]}" Command="{Binding Settings.ReloadCommand}"/></WrapPanel><TextBlock x:Name="ConfigPath" FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,12,0,0"><TextBlock.Text><MultiBinding Converter="{StaticResource LanguageText}" Mode="OneWay"><Binding Path="Settings.ConfigPath"/><Binding Path="DataContext.Texts.Language" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
      </Grid></TabItem>
      <TabItem Header="{Binding Texts[UI.LogTab]}"><TextBox x:Name="LogBox" TextChanged="OnLogTextChanged" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="16"><TextBox.Text><MultiBinding Converter="{StaticResource LanguageText}" Mode="OneWay"><Binding Path="LogText"/><Binding Path="DataContext.Texts.Language" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/></MultiBinding></TextBox.Text></TextBox></TabItem>
    </TabControl>
  </Grid>
</Window>

